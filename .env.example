# Postgres connection string (Neon: copy the "pooled" connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# 32-byte key used to encrypt students' ERP passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change it after students sign up (their saved ERP passwords would become unreadable).
ENCRYPTION_KEY=

# Public URL of the deployed site (used in email links)
APP_URL=http://localhost:3000

# Secret used by the scheduled job to call /api/cron. Any long random string.
CRON_SECRET=

# Email (SMTP). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=yourgmail@gmail.com, SMTP_PASS=<16-char Google App Password>
# If SMTP_HOST is empty, emails are printed to the server log instead (handy for local dev).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ERP Reminder <yourgmail@gmail.com>"

# Optional: restrict sign-ups to these email domains (comma separated), e.g. vcet.edu.in
ALLOWED_EMAIL_DOMAINS=

# ERP base URL (only change for testing against the mock ERP)
ERP_BASE_URL=https://erp.vcet.edu.in
